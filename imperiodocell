<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WR Importados</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#f5f6fa;
}

header{
background:#005eff;
padding:15px 5%;
display:flex;
align-items:center;
justify-content:space-between;
flex-wrap:wrap;
color:#fff;
position:sticky;
top:0;
z-index:100;
}

.logo{
font-size:28px;
font-weight:bold;
}

.search{
width:45%;
padding:12px;
border:none;
border-radius:8px;
}

.menu a{
color:#fff;
text-decoration:none;
margin-left:20px;
font-weight:bold;
}

.banner{
background:linear-gradient(135deg,#005eff,#00b3ff);
padding:80px 20px;
text-align:center;
color:white;
}

.banner h1{
font-size:50px;
margin-bottom:15px;
}

.banner p{
font-size:20px;
}

.produtos{
padding:40px 5%;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:white;
border-radius:18px;
overflow:hidden;
box-shadow:0 4px 15px rgba(0,0,0,.1);
transition:.3s;
}

.card:hover{
transform:translateY(-5px);
}

.card img{
width:100%;
height:220px;
object-fit:cover;
}

.info{
padding:15px;
text-align:center;
}

.preco{
font-size:26px;
color:#00a000;
font-weight:bold;
margin:10px 0;
}

.btn{
background:#005eff;
color:white;
padding:12px;
border:none;
border-radius:8px;
width:100%;
cursor:pointer;
font-size:16px;
}

.pix{
padding:50px 20px;
display:flex;
justify-content:center;
}

.pix-card{
background:white;
max-width:500px;
width:100%;
padding:30px;
text-align:center;
border-radius:20px;
box-shadow:0 4px 15px rgba(0,0,0,.1);
}

.pix-card img{
width:280px;
max-width:100%;
}

.pix-btn{
display:inline-block;
margin-top:15px;
padding:12px 20px;
background:#25D366;
color:white;
text-decoration:none;
border-radius:10px;
font-weight:bold;
}

footer{
background:#111;
color:white;
padding:25px;
text-align:center;
margin-top:40px;
}

.whats{
position:fixed;
right:20px;
bottom:20px;
background:#25D366;
color:white;
padding:15px 20px;
border-radius:50px;
text-decoration:none;
font-weight:bold;
}
</style>
</head>

<body>

<header>
<div class="logo">WR IMPORTADOS</div>

<input class="search" placeholder="Buscar produtos...">

<nav class="menu">
<a href="#">Início</a>
<a href="#">Celulares</a>
<a href="#">Notebooks</a>
<a href="#">Conta</a>
<a href="#">🛒 Carrinho</a>
</nav>
</header>

<section class="banner">
<h1>OFERTAS IMPERDÍVEIS</h1>
<p>iPhones, Samsung, Motorola e Notebooks com desconto no Pix</p>
</section>

<section class="produtos">

<div class="card">
<img src="https://images.unsplash.com/photo-1592750475338-74b7b21085ab">
<div class="info">
<h3>iPhone 15</h3>
<div class="preco">R$ 4.799</div>
<button class="btn">Comprar</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1610945265064-0e34e5519bbf">
<div class="info">
<h3>Samsung Galaxy S24</h3>
<div class="preco">R$ 3.299</div>
<button class="btn">Comprar</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1588872657578-7efd1f1555ed">
<div class="info">
<h3>Motorola Edge</h3>
<div class="preco">R$ 2.199</div>
<button class="btn">Comprar</button>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853">
<div class="info">
<h3>Notebook Dell i5</h3>
<div class="preco">R$ 2.899</div>
<button class="btn">Comprar</button>
</div>
</div>

</section>

<section class="pix">
<div class="pix-card">
<h2>Pague com Pix</h2>

<img src="qrcode_apenas.png" alt="QR Code Pix">

<h3>WELISSON DOS SANTOS ROCHA</h3>

<p>Escaneie o QR Code e envie o comprovante.</p>

<a class="pix-btn" href="https://wa.me/5511913028832">
Enviar Comprovante
</a>
</div>
</section>

<footer>
© 2026 WR IMPORTADOS - Todos os direitos reservados
</footer>

<a class="whats" href="https://wa.me/5511913028832">
WhatsApp
</a>

</body>
</html>
